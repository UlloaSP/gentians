# IDs exactos de la campaña. Cambia aquí la selección de experimentos.
GENTIANS_STEADY_ID=ilasp-all-1800s-10runs/gentians-steady_state
GENTIANS_INCREMENTAL_ID=ilasp-all-1800s-10runs/gentians-incremental
ILASP_EXPERIMENT_ID=all-1800s-10runs

# Recursos de cada job. --time cubre todos sus runs, no cada run individual.
GENTIANS_SLURM_PARTITION=no-gpu
GENTIANS_SLURM_CPUS=1
GENTIANS_SLURM_MEM=8G
GENTIANS_SLURM_TIME=7-00:00:00
ILASP_SLURM_TIME=14-00:00:00
